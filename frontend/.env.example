NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_LOCAL_API=false
NEXT_PUBLIC_API_URL=https://your-api.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Optional Google Drive import (public browser configuration; never a client secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=your-restricted-browser-api-key
# Numeric Google Cloud project number, not the project name or project ID.
NEXT_PUBLIC_GOOGLE_APP_ID=your-google-cloud-project-number
