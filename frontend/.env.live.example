# Copy these settings into .env.local after replacing the three stack outputs.
# Use the same values in Amplify's build environment.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_LOCAL_API=false
NEXT_PUBLIC_API_URL=<ApiUrl>
NEXT_PUBLIC_COGNITO_USER_POOL_ID=<UserPoolId>
NEXT_PUBLIC_COGNITO_CLIENT_ID=<UserPoolClientId>

# Optional Google Drive import. Restrict credentials to the deployed origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<GoogleWebOAuthClientId>
NEXT_PUBLIC_GOOGLE_API_KEY=<RestrictedGoogleBrowserApiKey>
NEXT_PUBLIC_GOOGLE_APP_ID=<NumericGoogleCloudProjectNumber>
